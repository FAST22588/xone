#!/bin/bash
set -u

if [ "$(id -u)" -ne 0 ]; then
    echo "Run as root." >&2
    exit 1
fi
if ! command -v systemctl >/dev/null 2>&1; then
    echo "systemd is required for this repair." >&2
    exit 1
fi

systemctl daemon-reload
_status=0
for _unit in sslh.service ws-tls.service ws-nontls.service ws-ovpn.service; do
    if systemctl cat "$_unit" >/dev/null 2>&1; then
        if ! systemctl restart "$_unit"; then
            echo "Could not restart $_unit" >&2
            _status=1
        fi
    fi
done
for _unit in badvpn1.service badvpn2.service badvpn3.service; do
    if systemctl cat "$_unit" >/dev/null 2>&1; then
        systemctl restart "$_unit" || _status=1
    fi
done

if [ -f /etc/rc.local ]; then
    echo "Kept existing /etc/rc.local unchanged."
fi
systemctl --no-pager --full status sslh.service ws-tls.service 2>/dev/null | sed -n '1,18p' || true
[ "$_status" -eq 0 ] && echo "SSLH and available WebSocket services were restarted."
exit "$_status"