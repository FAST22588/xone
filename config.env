# Xone project settings. Source this file from the project scripts.
: "${PROJECT_NAME:=Xone VPN}"
: "${PROJECT_OWNER:=FAST22588}"
: "${PROJECT_REPO:=xone}"
: "${PROJECT_BRANCH:=main}"
: "${PROJECT_CONFIG_DIR:=/etc/nevermore-vpn}"
: "${PROJECT_INSTALL_DIR:=/opt/nevermore-vpn}"

# Keep these owners on the upstream repositories until matching copies exist.
: "${ADDONS_OWNER:=NevermoreSSH}"
: "${ADDONS_REPO:=addons}"
: "${SLOWDNS_OWNER:=NevermoreSSH}"
: "${SLOWDNS_REPO:=hopp}"
: "${SLOWDNS_BRANCH:=main}"

: "${UDP_CUSTOM_PORT:=36712}"
: "${UDP_CUSTOM_EXCLUDE:=}"
: "${UDP_CUSTOM_MAX_CLIENTS:=500}"
